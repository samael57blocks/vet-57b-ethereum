# Backend URL (used when VITE_USE_MOCK_DATA=false — reads from Go indexer REST API)
VITE_BACKEND_URL=http://localhost:8080

# Set to true to use mock data, false (or unset) to use the backend REST API
VITE_USE_MOCK_DATA=true

# Vet wallet address for mock mode role checks (Hardhat account #0; dev.sh sets this)
VITE_VET_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# VetRegistry contract address (update after deploying to localhost)
VITE_CONTRACT_ADDRESS=

# USDC token address (MockERC20 deployed alongside VetRegistry)
VITE_USDC_ADDRESS=

# MockPriceFeed address (ETH/USD price feed for ETH payments)
VITE_PRICE_FEED_ADDRESS=
